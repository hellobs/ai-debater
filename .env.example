# 复制为 .env 后填写真实值。本文件只列变量名，不含任何凭据。
# .env 已在 .gitignore 中排除，绝不入仓。

# --- 上游模型网关（Anthropic 协议）---
# 只被 backend/app/llm_bridge.py 读取，用于向上游发起 /v1/messages 请求
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_VERSION=2023-06-01

# --- 模型（非敏感）---
LLM_MODEL=deepseek-chat

# --- 我方协议桥（mavis 指向它）---
LLM_BRIDGE_HOST=127.0.0.1
LLM_BRIDGE_PORT=8011
LLM_BRIDGE_URL=http://127.0.0.1:8011/v1
LLM_BRIDGE_MAX_TOKENS=2048
LLM_BRIDGE_TIMEOUT=120

# --- 提示词模板目录 ---
# 提示词走 mavis 的模板层（Scratch.build_prompt），所以目录沿用 mavis 认的变量名。
# 不填 = <仓库>/prompts（layout.txt / roles/*.txt / tasks/*.txt）。
# 改这里可以整体换成另一套提示词，不用动代码。
MAVIS_PROMPT_DIR=

# --- 数据 ---
# LEDGER_DB=
