# 复制为 .env 后填写真实值。本文件只列变量名，不含任何凭据。
# .env 已在 .gitignore 中排除，绝不入仓。

# --- 上游模型网关（Anthropic 协议）---
# 只被 backend/app/llm_bridge.py 读取，用于向上游发起 /v1/messages 请求
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_VERSION=2023-06-01

# --- 模型（非敏感）---
LLM_MODEL=deepseek-chat
# 启动时用哪个形态：ollama / openai / anthropic。留空则按下面的凭据自动推断
# （有 ANTHROPIC_BASE_URL → anthropic，否则 ollama）。界面上随时可改，不必写在文件里。
# UPSTREAM_KIND=
# 同一时刻最多几个请求在飞（mavis provider 的全局信号量）。
# 本地 Ollama 单实例：超了只是排队，还抢显存，scripts/run_local.sh 预设为 2；
# 接云端网关时才应调到 ≥ 参谋路数（5）。
# LLM_CONCURRENCY=4

# --- 我方协议桥（mavis 指向它）---
LLM_BRIDGE_HOST=127.0.0.1
LLM_BRIDGE_PORT=8011
LLM_BRIDGE_URL=http://127.0.0.1:8011/v1
# LLM_BRIDGE_MAX_TOKENS=2048
# 桥的 HTTP 超时。必须 ≥ 下面的 LLM_TIMEOUT_S，否则桥先超时返回空，
# 会触发 mavis 的重试（重试是真花钱的）
LLM_BRIDGE_TIMEOUT=180

# --- 时间（两层：外层管交付，内层管单次调用）---
# 整轮墙钟预算：到点就把已好的部分交付，没回来的标「超时」并立刻推送。
# 现场 12–20s；本地模型建议 120s；0 = 不限（仍受下面那条封顶，不是真的无限）
ADVISOR_BUDGET_S=30
# 单次上游调用上限，传给 mavis 的 completion(timeout=)（mavis 自己默认 90s）。
# 代码会取 max(ADVISOR_BUDGET_S, LLM_TIMEOUT_S)：内层不能比外层先到点，
# 否则 mavis 先超时并重试，钱花了、答案却已被外层判死
LLM_TIMEOUT_S=90

# --- 提示词模板目录 ---
# 提示词走 mavis 的模板层（Scratch.build_prompt），所以目录沿用 mavis 认的变量名。
# 不填 = <仓库>/prompts（layout.txt / packs/<包>/{roles,tasks}/*.txt）。
# 改这里可以整体换成另一套提示词，不用动代码。
MAVIS_PROMPT_DIR=

# --- 站点品牌 ---
# 平台是通用辩手参谋台，「AI + 法学」只是落地场景之一，不当品牌名。
# BRAND_NAME=辩手参谋台

# --- 后端自身 ---
# API_HOST=127.0.0.1
# API_PORT=8010

# --- 配置与数据文件的位置（都可覆盖，默认就在仓库里）---
# 参谋名册（决定上哪几路、显示名、开关）
# ADVISORS_YAML=configs/advisors.yaml
# 领域 → 提示词包的映射
# PROMPT_PACKS_YAML=configs/prompt-packs.yaml
# 辩题库：入仓预设 + 本机自建（后者不入仓）
# TOPICS_YAML=configs/topics.yaml
# TOPICS_JSON=data/topics.json
# 引用核验用的法条语料目录（空目录 = 所有引用只能判「未核验」）
# CORPUS_DIR=data/corpus
# 论点台账（SQLite，必须外置：mavis 的记忆是固定 schema，装不下）
# LEDGER_DB=data/ledger.db
